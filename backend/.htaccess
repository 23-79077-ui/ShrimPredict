DirectoryIndex index.html index.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Huwag i-rewrite kung ang request ay papunta sa API, umiiral na file, o folder
  RewriteCond %{REQUEST_URI} ^/api/ [NC,OR]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # I-route ang lahat ng iba pang page papuntang index.html para sa React Router
  RewriteRule ^ index.html [L]
</IfModule>
